# ─────────────────────────────────────────────────────────────
# 这是 GitHub Actions 的 CI 配置「示例」。
#
# 为什么不直接放在 .github/workflows/ 里：
#   GitHub 要求 Personal Access Token 额外具备 workflow scope
#   才能推送 .github/workflows/ 下的文件。
#   为了让只有 repo 权限的 token 也能推送整个项目，
#   这里把它做成手动启用的模板。
#
# 启用方法（在网页上两步即可）：
#   1. 仓库页 → Add file → Create new file
#   2. 文件名填 .github/workflows/build.yml
#      内容粘贴本文件全部内容 → Commit changes
#
# 启用后每次 push 会自动：跑 409 项测试 → 用标准 Android SDK
# 打包 APK（能正确生成图标与资源）→ 上传构建产物。
# ─────────────────────────────────────────────────────────────

name: Build

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  test:
    name: 测试
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: 构建网页版
        run: node build.js
      - name: 运行测试（不需要 jsdom 的部分）
        run: |
          node test/headless.js
          node test/static-check.js
          node test/playthrough.js
          node test/ai-module.js
          node test/ai-native-bridge.js

  apk:
    name: 打包 APK
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3

      - name: 安装 Android 构建组件
        run: sdkmanager "build-tools;34.0.0" "platforms;android-34"

      - name: 构建网页版
        run: node build.js

      - name: 生成签名密钥
        run: node tools/make-keystore.js

      - name: 打包 APK
        env:
          ANDROID_SDK: ${{ env.ANDROID_HOME }}
          JAVA_HOME: ${{ env.JAVA_HOME }}
        run: python3 tools/build_apk.py

      - name: 校验产物
        run: |
          ls -la dist/
          $ANDROID_HOME/build-tools/34.0.0/apksigner verify --verbose dist/*.apk

      - name: 上传构建产物
        uses: actions/upload-artifact@v4
        with:
          name: fx-kurumi
          path: |
            dist/index.html
            dist/*.apk
          retention-days: 90

  release:
    name: 发布
    runs-on: ubuntu-latest
    needs: apk
    if: startsWith(github.ref, 'refs/tags/')
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: fx-kurumi
          path: out
      - uses: softprops/action-gh-release@v2
        with:
          files: |
            out/index.html
            out/*.apk
          generate_release_notes: true
