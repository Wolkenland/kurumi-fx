name: Build

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  test:
    name: 测试
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: 构建网页版
        run: node build.js
      - name: 运行测试（不需要 jsdom 的部分）
        run: |
          node test/headless.js
          node test/static-check.js
          node test/playthrough.js
          node test/ai-module.js
          node test/ai-native-bridge.js

  apk:
    name: 打包 APK
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3

      - name: 安装 Android 构建组件
        run: sdkmanager "build-tools;34.0.0" "platforms;android-34"

      - name: 构建网页版
        run: node build.js

      - name: 生成签名密钥
        run: node tools/make-keystore.js

      - name: 打包 APK
        env:
          ANDROID_SDK: ${{ env.ANDROID_HOME }}
          JAVA_HOME: ${{ env.JAVA_HOME }}
        run: python3 tools/build_apk.py

      - name: 校验产物
        run: |
          ls -la dist/
          $ANDROID_HOME/build-tools/34.0.0/apksigner verify --verbose dist/*.apk

      - name: 上传构建产物
        uses: actions/upload-artifact@v4
        with:
          name: fx-kurumi
          path: |
            dist/index.html
            dist/*.apk
          retention-days: 90

  release:
    name: 发布
    runs-on: ubuntu-latest
    needs: apk
    if: startsWith(github.ref, 'refs/tags/')
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: fx-kurumi
          path: out
      - uses: softprops/action-gh-release@v2
        with:
          files: |
            out/index.html
            out/*.apk
          generate_release_notes: true
